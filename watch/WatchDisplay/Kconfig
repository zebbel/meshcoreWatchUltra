menu "meshcoreWatchUltra watch clock"
    config MCW_WATCH_CLOCK_TIMEZONE
        string "Clock page POSIX timezone"
        default "CET-1CEST,M3.5.0,M10.5.0/3"
        help
            POSIX TZ specification used to display the local time. The default
            shows Germany's CET/CEST with automatic daylight-saving changes.
            This affects only local-time formatting; the RTC and GPS store UTC.

    config MCW_WATCH_CLOCK_LARGE_FONT
        bool "Include 48px font for the watch clock"
        default y
        select LV_FONT_MONTSERRAT_48
        select LV_FONT_MONTSERRAT_28
        help
            Include LVGL's built-in Montserrat 48 font for the 2x centered
            time and Montserrat 28 for the battery percentage.
    config MCW_WATCH_CLOCK_STATUS_FONT
        bool "Use 40px font for GPS / MeshCore / BLE status"
        default y
        select LV_FONT_MONTSERRAT_40
        help
            Double status text from 20px to a native 40px font without
            scaling an intermediate rendering layer.

endmenu
